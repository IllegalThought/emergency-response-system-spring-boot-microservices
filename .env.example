# PostgreSQL
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=campus_password

# Database URLs
IDENTITY_DB_URL=jdbc:postgresql://localhost:5433/identity_db
INCIDENT_DB_URL=jdbc:postgresql://localhost:5433/incident_db

# RabbitMQ
RABBITMQ_DEFAULT_USER=campus_admin
RABBITMQ_DEFAULT_PASS=campus_password

# JWT
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET

# Frontend
FRONTEND_ORIGIN=http://localhost:3000